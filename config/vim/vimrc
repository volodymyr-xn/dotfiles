function! LighlineTabFilenameWithParentDir(n) abort
  let buflist = tabpagebuflist(a:n)
  let winnr = tabpagewinnr(a:n)
  let bufnum = buflist[winnr - 1]
  let bufname = expand('#'.bufnum.':t')
  let buffullname = expand('#'.bufnum.':a')
  " let buffullname = expand('#')
  " return buffullname
  " return substitute(buffullname, '.*/\([^/]\+/\)', '\1', '')
  if strlen(bufname)
    return substitute(buffullname, '.*/\([^/]\+/\)', '\1', '')
  else
    return strlen(bufname) ? bufname : '[No Name]'
  endif
endfunction

function! IsCurrentWindowZoomed()
  if !exists("t:currentWindowZoomed")
    let t:currentWindowZoomed = 0
  end

  if t:currentWindowZoomed
    return '  ///   VIM WINDOW ZOOM    ///'
  else
    return ''
  endif
endfunction

