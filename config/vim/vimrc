function! ReloadActiveChromeTab()
  let l:currentTerminalEmulator = system("xdotool getactivewindow")

  execute system('
     \ xdotool search --onlyvisible --class Chrome windowfocus key F5
     \ && xdotool windowfocus ' . l:currentTerminalEmulator)

  echo "Chrome tab reloaded"
endfunction

" Toggle zoom of current window
function! ToggleCurrentWindowZoom()
  if !exists("t:currentWindowZoomed")
    let t:currentWindowZoomed = 0
    " TODO check nerdtree state
  endif

  if t:currentWindowZoomed
    execute "normal \<C-W>="
    let t:currentWindowZoomed = 0
  else
    :NERDTreeClose
    execute "normal \<C-W>\| \<C-W>_"
    let t:currentWindowZoomed = 1
  endif
endfunction

