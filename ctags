--sort=yes
--recurse
--append
--exclude=.git
--exclude=node_modules
--exclude=coverage
--exclude=vendor
--exclude=bower_components
--exclude=log
--exclude=tmp
--exclude=bin
--exclude=dist
--exclude=tags

--langdef=css
--langmap=css:.css
--langmap=css:+.scss
--langmap=css:+.sass
--langmap=css:+.styl
--langmap=css:+.less
--regex-css=/^[ \t]*\.([A-Za-z0-9_]+-[A-Za-z0-9_-]+)( |$)/.\1/c,class,classes/
--regex-css=/^([\$@][A-Za-z0-9_-]+): /\1/v,variable,variables/
--regex-css=/^([A-Za-z0-9_-]+) = /\1/v,variable,variables/
--regex-css=/^[ \t]*(@mixin |= ?)([A-Za-z0-9_-]+)/\2/m,mixin,mixins/


--languages=-javascript
--langdef=js
--langmap=js:.js
--langmap=js:+.jsx
