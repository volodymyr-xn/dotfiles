#Confirms that a surface should be closed before closing it.

# This defaults to true. If set to false, surfaces will close without any confirmation. This can # also be set to always, which will always confirm closing a surface, even if shell integration # says a process isn't running.
confirm-close-surface=false

# Whether or not to quit after the last surface is closed.
# This defaults to false on macOS since that is standard behavior for a macOS application. On Linux, this defaults to true since that is generally expected behavior.
# On Linux, if this is true, Ghostty can delay quitting fully until a configurable amount of time has passed after the last window is closed. See the documentation of quit-after-last-window-closed-delay.
# quit-after-last-window-closed=true

#font-family = "CaskaydiaMono Nerd Font"
# font-family = "JetBrains Mono Semi Bold"
# font-style = "Regular"
font-size = 14

# cursor-style = bar

# adjust-cell-height = -5
adjust-cell-height = -2

maximize = true

# The titlebar is dead space: windows open maximized and tmux already draws a
# status bar with the session/window context a titlebar would show.
macos-titlebar-style = hidden

desktop-notifications = true

# Notify only when the window is unfocused and the command ran long enough to
# be worth switching back for (long AI runs, test suites). Works through tmux
# because tmux.conf sets `allow-passthrough all`, so OSC 133 reaches ghostty.
notify-on-command-finish = unfocused
notify-on-command-finish-after = 30s

# Drop ghostty's `cursor` shell-integration feature: the cursor shape is owned
# by nvim and zsh (through tmux), and ghostty re-asserting it after every
# prompt fights them. `title` and `path` stay for window titles and OSC 7.
shell-integration-features = no-cursor,title,path

# Suppress the size popup on resize — tmux already reports pane geometry.
resize-overlay = never

# Hide the pointer while typing so it never covers the text under it.
mouse-hide-while-typing = true

# Sessions are restored by tmux, not by ghostty's surface restore. Leaving the
# default on relaunches saved surfaces and duplicates the shells tmux revives.
window-save-state = never

# tmux's history-limit is the real scrollback here, so ghostty's default 50 MB
# per surface is wasted resident memory.
scrollback-limit-bytes = 5000000

# Pin the update channel: this install tracks `tip`, and without an explicit
# value an update can silently move it to `stable`, dropping tip-only options.
auto-update-channel = tip



background-opacity = 1

background-blur = 0

macos-option-as-alt = left

# Open quake like terminal
#keybind = global:cmd+backquote=toggle_quick_terminal

# Used in applications which need newline insert with shitft-enter
keybind = shift+enter=text:\x1b\r

# Send a plain carriage return for ctrl+enter, replacing ghostty's default
# window zoom. It has to happen here: inside a tmux display-popup tmux's key
# tables are bypassed, and fzf cannot bind ctrl+enter under any name
# ("unsupported key"), so the AI pane picker only sees this chord if the
# terminal hands it over as Enter. Side effect: ctrl+enter now acts as Enter
# everywhere, where before it did nothing outside tmux's tree-mode.
keybind = ctrl+enter=text:\r

# Ctrl+, toggles the AI agent pane selector. Sent as ESC+comma so it lands as
# M-, in tmux (which opens the popup) and as alt-, in fzf (which aborts it) —
# fzf refuses to bind ctrl-, itself, and inside a tmux popup the tmux key
# tables are bypassed, so the close half can only come from fzf.
keybind = ctrl+comma=text:\x1b,

# Disable split pane shortcut so cmd+d can be used for zsh word forward navigation
keybind = cmd+d=unbind

# Disable new tab shortcut so cmd+t can be used by the shell/app inside Ghostty
keybind = cmd+t=unbind

# Disable new window shortcut so cmd+n can be used by the shell/app inside Ghostty
keybind = cmd+n=unbind

# Pass cmd+k to Hammerspoon for app/Space/tmux navigation (restoreFull)
keybind = cmd+k=unbind

# Switch tmux windows with Ctrl+1-9. Sends tmux prefix (Ctrl+A = \x01) + number.
# Needed because macOS intercepts Ctrl+number for Mission Control before Ghostty sees them.
keybind = ctrl+one=text:\x01\x31
keybind = ctrl+two=text:\x01\x32
keybind = ctrl+three=text:\x01\x33
keybind = ctrl+four=text:\x01\x34
keybind = ctrl+five=text:\x01\x35
keybind = ctrl+six=text:\x01\x36
keybind = ctrl+seven=text:\x01\x37
keybind = ctrl+eight=text:\x01\x38
keybind = ctrl+nine=text:\x01\x39

# Ctrl+0 switches to the next tmux session. Same workaround as the numbers
# above: sends the tmux prefix + `0`, reusing the `prefix 0` binding, because
# macOS eats Ctrl+0 before Ghostty can deliver it as a real key.
keybind = ctrl+zero=text:\x01\x30

# Make fonts bolder (works only on MacOS)
font-thicken=true
font-thicken-strength=1

