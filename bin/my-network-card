#!/usr/bin/env ruby

# Display network card hardware information

module PCIDevicesInfo
  NETWORK_DEVICE_NAME_REGEX = /[Nn]et/

  def self.all
    `lspci`.split("\n")
  end

  def self.network_devices
    all.select { _1.match(NETWORK_DEVICE_NAME_REGEX) }
  end

  def self.network_devices_details
    network_devices
      .map { _1.split(/\s/).first }
      .map { `lspci -ks #{_1}` + "\n" }
  end

  def self.network_devices_details_full
    `lshw -class network`
  end
end

puts PCIDevicesInfo.network_devices_details_full
