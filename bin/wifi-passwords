#!/usr/bin/env bash

# Display saved WiFi passwords (macOS and Linux)

set -euo pipefail

if [[ "$OSTYPE" == *'arwin'* ]]; then
  security find-generic-password -D "AirPort network password" -g -w
elif [[ -d /etc/NetworkManager/system-connections/ ]]; then
  sudo su
  grep -H '^psk=' "/etc/NetworkManager/system-connections/*"
  exit
fi
