#!/usr/bin/env bash

# Create symlink to directory in destination, resolving relative paths

set -euo pipefail

dir_to_symlink="$1"
destination_dir="$2"

dir_to_symlink_full_path=$(readlink -f "$dir_to_symlink")
dir_to_symlink_basename=$(basename "$dir_to_symlink")

echo "Symlinking $dir_to_symlink_full_path -> $destination_dir/$dir_to_symlink_basename"

ln -nsf "$dir_to_symlink_full_path" "$destination_dir/$dir_to_symlink_basename"
