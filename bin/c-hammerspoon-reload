#!/usr/bin/env bash
# Reload the running Hammerspoon config from the CLI.
#
# Uses a DEFERRED reload: a synchronous `hs -c "hs.reload()"` tears down the
# hs.ipc message port it is replying over, so it always exits 69 with a
# "corrupt Mach message" even on success. Deferring by 0.2s lets the IPC call
# return cleanly first, then the reload fires.
#
# If the IPC port is unavailable (Hammerspoon not running, or started before
# `require("hs.ipc")` existed) it bootstraps by fully relaunching the app —
# a plain Quit event, needing neither IPC nor AppleScript-in-config.
set -euo pipefail

# Run `hs -c` with a hard timeout. macOS has no `timeout(1)`, and a wedged
# Hammerspoon IPC port makes `hs -c` block forever instead of erroring —
# which would hang every probe below. signal.alarm gives us a portable
# timeout: SIGALRM kills the child, and execvp inherits the pending timer.
hs_timed() {
  local secs="$1"; shift
  python3 -c 'import os, signal, sys; signal.alarm(int(sys.argv[1])); os.execvp(sys.argv[2], sys.argv[2:])' "$secs" hs "$@"
}

ipc_ready() { hs_timed 2 -c 'return 1' >/dev/null 2>&1; }

# Poll the IPC port for up to ~15s; succeeds as soon as it answers.
wait_for_ipc() {
  local _
  for _ in $(seq 1 15); do
    ipc_ready && return 0
    sleep 1
  done
  return 1
}

# Wait until a FRESH instance answers (sentinel absent => new Lua state).
wait_for_fresh() {
  local _ out
  for _ in $(seq 1 15); do
    out=$(hs_timed 2 -c 'return RELOAD_SENTINEL == nil and "fresh" or "stale"' 2>/dev/null || true)
    if [ "$out" = "fresh" ]; then
      return 0
    fi
    sleep 1
  done
  return 1
}

if ipc_ready; then
  hs_timed 2 -c 'RELOAD_SENTINEL = true; hs.timer.doAfter(0.2, hs.reload)' >/dev/null 2>&1 || true

  if wait_for_fresh; then
    echo "Hammerspoon reloaded."
    exit 0
  fi

  echo "Reload issued but no fresh instance answered; check the Hammerspoon console." >&2
  exit 1
fi

echo "IPC port unavailable; relaunching Hammerspoon to bootstrap..." >&2

# Cooperative quit first (gives Hammerspoon a chance to flush state). If it's
# wedged it will ignore both AppleScript quit and SIGTERM, so escalate.
osascript -e 'quit app "Hammerspoon"' >/dev/null 2>&1 || true
pkill -TERM -f "/Applications/Hammerspoon.app/Contents/MacOS/Hammerspoon" 2>/dev/null || true
for _ in $(seq 1 5); do
  pgrep -f "/Applications/Hammerspoon.app/Contents/MacOS/Hammerspoon" >/dev/null || break
  sleep 1
done
pkill -KILL -f "/Applications/Hammerspoon.app/Contents/MacOS/Hammerspoon" 2>/dev/null || true
sleep 1

open -a Hammerspoon

if wait_for_ipc; then
  echo "Hammerspoon relaunched; IPC live."
  exit 0
fi

echo "Hammerspoon relaunched but IPC still unavailable." >&2
echo 'Check that init.lua has require("hs.ipc") at the top and loads without errors.' >&2
exit 1
