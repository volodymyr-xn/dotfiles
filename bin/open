#!/usr/bin/env bash

# Open file with default application (macOS/Linux compatible)

set -euo pipefail

if command -v xdg-open >/dev/null 2>&1; then
    xdg-open "$@"
elif [ -x /usr/bin/open ]; then
    /usr/bin/open "$@"
else
    echo "Error: Could not find a suitable command to open files." >&2
    exit 1
fi

