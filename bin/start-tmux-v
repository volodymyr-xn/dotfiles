#!/usr/bin/env bash

# Create or attach tmux session with Neovim editor

while getopts "d:n:" opt; do
  case ${opt} in
    d ) directory_name=$OPTARG ;;
    n ) tmux_session_name=$OPTARG ;;
    \? ) echo "Usage: $0 [-d DIRECTORY] [-n SESSION_NAME]"
         exit 1 ;;
  esac
done

vim_executable="nvim"

is_tmux_server_running() {
  [[ -n $(pgrep tmux) ]] && return 0 || return 1
}

is_session_exist() {
  if is_tmux_server_running ; then
    return $(tmux has-session -t "$tmux_session_name")
  else
    return 1
  fi
}

attach_to_session() {
  tmux attach-session -t "$tmux_session_name" > /dev/null
}

switch_to_session() {
  tmux switch -t "$tmux_session_name" > /dev/null
}

connect_to_session() {
  if [ -n "$TMUX" ]; then
    switch_to_session
  else
    attach_to_session
  fi
}

create_session() {
  tmux new-session \
        -d \
        -s "$tmux_session_name" \
        -c "$directory_name" \
        -n vim

  tmux send-keys \
        -t "$tmux_session_name":1 \
        "$vim_executable" C-m
}

if is_session_exist ; then
  connect_to_session
else
  create_session
  connect_to_session
fi
