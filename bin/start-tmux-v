#!/usr/bin/env bash

# set -euo pipefail

tmux_session_name="$1"
directory_name="$2"

echo "$tmux_session_name"

is_tmux_server_running() {
  [[ -n $(pgrep tmux) ]] && return 0 || return 1
}

is_session_exist() {
  if is_tmux_server_running ; then
    return $(tmux has-session -t "$tmux_session_name")
  else
    return 1
  fi
}

attach_to_session() {
  tmux attach-session -t "$tmux_session_name" > /dev/null
}

switch_to_session() {
  tmux switch -t "$tmux_session_name" > /dev/null
}

connect_to_session() {
  if [ -n "$TMUX" ]; then
    switch_to_session
  else
    attach_to_session
  fi
}

create_session() {
  # Create a new tmux session_name, starting vim from a saved
  # session_name in the new window
  tmux new-session \
        -d \
        -s "$tmux_session_name" \
        -c "$directory_name" \
        -n vim

  # Run vim
  tmux send-keys \
        -t "$tmux_session_name":1 \
        vim C-m
}

if is_session_exist ; then
  connect_to_session
else
  create_session
  connect_to_session
fi
