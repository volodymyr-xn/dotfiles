#!/usr/bin/env bash

# Delete all images which are not used by existing containers
docker image prune -a

# Delete all stoped containers
# Only deletes stopped containers older than 240 hours
docker container prune --filter "until=240h"

# Docker networks don’t take up much disk space, but they do create iptables
# rules, bridge network devices, and routing table entries.
# Delete networks which aren’t used by any containers.
docker network prune
