#!/usr/bin/env bash

set -euo pipefail

# Main directory
MAIN_DIR="$1"
COMMAND_RUNNER_TITLE=${2:-"Command"}

readarray -t COMMAND_FILES <<< "$(find "$MAIN_DIR" -type f,l -maxdepth 1)"

declare -A COMMAND_FILES_MAP

if [[ ! -z ${COMMAND_FILES[@]} ]]; then
  for i in "${!COMMAND_FILES[@]}"
  do
    path=${COMMAND_FILES[$i]}
    filename=$(basename "${COMMAND_FILES[$i]}")

    COMMAND_FILES_MAP+=([$filename]="$path")
  done
else
  echo "$MAIN_DIR is empty!"
  exit
fi

generate_display_list(){
  for i in "${!COMMAND_FILES_MAP[@]}"
  do
    echo "$i"
  done
}

selected_command=$( (generate_display_list) | rofi -dmenu -i -matching fuzzy -sorting-method fzf -no-custom -location 0 -p "$COMMAND_RUNNER_TITLE" )

if [ -n "$selected_command" ]; then
  bash "${COMMAND_FILES_MAP[$selected_command]}"
fi

exit 0
