#!/usr/bin/env bash

# container_name="$1"
#
# docker exec -it "$container_name" bash

# Parse named command-line arguments
while [[ $# -gt 0 ]]; do
  key="$1"
  case $key in
    -c|--container)
      container_name="$2"
      shift # past argument
      shift # past value
      ;;
    *) # unknown option
      echo "Unknown option: $key"
      exit 1
      ;;
  esac
done

# Check if container name was provided
if [ -z "$container_name" ]; then
  echo "Error: Container name not provided"
  echo "Usage: $0 --container [container_name]"
  exit 1
fi

docker exec -it "$container_name" bash

