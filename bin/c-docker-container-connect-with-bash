#!/usr/bin/env bash

# Connect to Docker container with bash shell

while [[ $# -gt 0 ]]; do
  key="$1"
  case $key in
    -c|--container)
      container_name="$2"
      shift
      shift
      ;;
    *) # unknown option
      echo "Unknown option: $key"
      exit 1
      ;;
  esac
done

if [ -z "$container_name" ]; then
  echo "Error: Container name not provided"
  echo "Usage: $0 --container [container_name]"
  exit 1
fi

docker exec -it "$container_name" bash

