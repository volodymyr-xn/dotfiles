#!/usr/bin/env bash

# Compress image quality using ImageMagick. Usage: c-compress-image [-q PERCENT] FILE [FILE...]

set -euo pipefail

quality=""
# Empty means "auto": .webp inputs stay webp, everything else becomes .jpg
forced_format=""
max_width=""
files=()

# Reject a second output-format flag instead of silently letting one win
set_forced_format() {
  local format="$1"

  if [[ -n "$forced_format" && "$forced_format" != "$format" ]]; then
    echo "Error: --webp and --jpeg are mutually exclusive" >&2
    exit 1
  fi

  forced_format="$format"
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    -q)
      quality="${2:-}"
      shift 2
      ;;
    -q=*)
      quality="${1#-q=}"
      shift
      ;;
    --webp)
      set_forced_format webp
      shift
      ;;
    --jpeg|--jpg)
      set_forced_format jpg
      shift
      ;;
    --max-width=*)
      max_width="${1#--max-width=}"
      max_width="${max_width%px}"
      shift
      ;;
    --max-width)
      max_width="${2:-}"
      max_width="${max_width%px}"
      shift 2
      ;;
    -h|--help)
      echo "Usage: c-compress-image [-q PERCENT] [--webp|--jpeg] [--max-width=PX] FILE [FILE...]"
      echo "  -q PERCENT       Quality 1-100 (prompted if omitted)"
      echo "  --webp           Force .webp output for every input"
      echo "  --jpeg           Force .jpg output, including for .webp inputs"
      echo "  --max-width=PX   Shrink to fit width (e.g. 2000 or 2000px); never upscale"
      echo ""
      echo "Default: .webp inputs are compressed in place; every other format"
      echo "becomes .jpg (transparency flattened onto white) and the original"
      echo "file is removed."
      exit 0
      ;;
    *)
      files+=("$1")
      shift
      ;;
  esac
done

if [[ -z "$quality" ]]; then
  read -r -p "Quality (1-100): " quality
fi

if ! [[ "$quality" =~ ^[0-9]+$ ]] || (( quality < 1 || quality > 100 )); then
  echo "Error: quality must be an integer between 1 and 100" >&2
  exit 1
fi

if [[ -n "$max_width" ]] && ! [[ "$max_width" =~ ^[0-9]+$ ]]; then
  echo "Error: --max-width must be a positive integer (got '$max_width')" >&2
  exit 1
fi

if [[ ${#files[@]} -eq 0 ]]; then
  echo "Error: no input files" >&2
  echo "Usage: c-compress-image [-q PERCENT] FILE [FILE...]" >&2
  exit 1
fi

# Prefer modern `magick` CLI; fall back to legacy `convert`
if command -v magick >/dev/null 2>&1; then
  im_cmd=(magick)
elif command -v convert >/dev/null 2>&1; then
  im_cmd=(convert)
else
  echo "Error: ImageMagick (magick or convert) not found in PATH" >&2
  exit 1
fi

# Format byte count as human-readable KB / MB / GB (1 decimal place)
human_size() {
  local bytes="$1"

  awk -v b="$bytes" 'BEGIN {
    if (b >= 1024*1024*1024) printf "%.1f GB", b/1024/1024/1024;
    else if (b >= 1024*1024) printf "%.1f MB", b/1024/1024;
    else if (b >= 1024)      printf "%.1f KB", b/1024;
    else                     printf "%d B", b;
  }'
}

# ANSI colors (only when stdout is a TTY, so pipes/logs stay clean)
if [[ -t 1 ]]; then
  C_RESET=$'\033[0m'
  C_GREEN=$'\033[32m'
  C_RED=$'\033[31m'
  C_YELLOW=$'\033[33m'
  C_DIM=$'\033[2m'
else
  C_RESET=""; C_GREEN=""; C_RED=""; C_YELLOW=""; C_DIM=""
fi

# Pick a color for size delta: smaller = green, larger = red, same = yellow
size_color() {
  local in_b="$1" out_b="$2"

  if (( out_b < in_b )); then
    printf '%s' "$C_GREEN"
  elif (( out_b > in_b )); then
    printf '%s' "$C_RED"
  else
    printf '%s' "$C_YELLOW"
  fi
}

compress_one() {
  local input="$1"
  local q="$2"

  if [[ ! -f "$input" ]]; then
    echo "Skip: '$input' is not a file" >&2
    return 1
  fi

  local target tmp in_size out_size color pct
  in_size=$(stat -f%z "$input" 2>/dev/null || stat -c%s "$input")

  # Compare extensions case-insensitively, with .jpeg treated as .jpg
  local input_ext="${input##*.}"
  input_ext=$(printf '%s' "$input_ext" | tr '[:upper:]' '[:lower:]')
  [[ "$input_ext" == "jpeg" ]] && input_ext="jpg"

  local out_ext
  if [[ -n "$forced_format" ]]; then
    out_ext="$forced_format"
  elif [[ "$input_ext" == "webp" ]]; then
    out_ext="webp"
  else
    out_ext="jpg"
  fi

  if [[ "$input_ext" == "$out_ext" ]]; then
    target="$input"
  else
    target="${input%.*}.${out_ext}"
  fi

  # The extension must stay last: ImageMagick picks the encoder from it and
  # silently falls back to the input's format when it looks unfamiliar
  tmp="${target%.*}.tmp.$$.${out_ext}"

  local -a resize_args=()
  if [[ -n "$max_width" ]]; then
    resize_args=(-resize "${max_width}x>")
  fi

  # JPEG has no alpha channel; without this transparency turns black
  local -a flatten_args=()
  if [[ "$out_ext" == "jpg" ]]; then
    flatten_args=(-background white -flatten)
  fi

  if ! "${im_cmd[@]}" "$input" "${flatten_args[@]}" "${resize_args[@]}" -quality "$q" "$tmp"; then
    echo "${C_RED}FAIL${C_RESET}: '$input'" >&2
    rm -f "$tmp"
    return 1
  fi

  # Replace original atomically; remove the source if extension changed
  if [[ "$target" != "$input" ]]; then
    mv -f "$tmp" "$target"
    rm -f "$input"
  else
    mv -f "$tmp" "$input"
  fi

  out_size=$(stat -f%z "$target" 2>/dev/null || stat -c%s "$target")
  color=$(size_color "$in_size" "$out_size")
  pct=$(awk -v a="$in_size" -v b="$out_size" 'BEGIN { if (a > 0) printf "%+.1f", (b-a)*100.0/a; else print "0.0" }')

  if [[ "$target" != "$input" ]]; then
    printf '%s -> %s  (%s -> %s, %s)\n' \
      "$input" "$target" \
      "${C_DIM}$(human_size "$in_size")${C_RESET}" \
      "${color}$(human_size "$out_size")${C_RESET}" \
      "${color}${pct}%${C_RESET}"
  else
    printf '%s  (%s -> %s, %s)\n' \
      "$input" \
      "${C_DIM}$(human_size "$in_size")${C_RESET}" \
      "${color}$(human_size "$out_size")${C_RESET}" \
      "${color}${pct}%${C_RESET}"
  fi
}

status=0
for f in "${files[@]}"; do
  compress_one "$f" "$quality" || status=$?
done

exit "$status"
