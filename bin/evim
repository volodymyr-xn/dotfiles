#!/usr/bin/env bash

set -euo pipefail

read -p "Enter your password: " -s pass

decrypted_content=$(gpg --batch --passphrase $pass -d $1)

if [ $? -eq 0 ] ; then
  echo 'Decrypted file successfully'
else
  echo 'Decryption error'
  exit 1
fi

result=$(echo $decrypted_content | vipe)

if ! [ $? -eq 0 ] ; then
  echo 'VIM exited with error'
  exit 1
fi

if [ -z "$result" ] ; then
  echo 'VIM returned blank string'
  exit 1
fi

echo $result \
  | gpg \
    -c \
    --batch \
    --passphrase $pass \
    --output $1 \
    --yes
