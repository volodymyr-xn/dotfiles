#!/usr/bin/env bash

# Dump PostgreSQL database to SQL file

# pg_dump "$1" > "$2"

database_name="$1"
backup_name="$database_name_$(date +"%d_%m_%Y")"

pg_dump --format=plain --inserts --column-inserts "$database_name" > "$backup_name".sql

# pg_dump --format=plain --inserts --column-inserts dbname > backup.sql

# ✅ Dump only one table as text SQL
# pg_dump --format=plain --inserts --column-inserts -t mytable dbname > mytable.sql
