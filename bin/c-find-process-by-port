#!/usr/bin/env bash

# Find process using a specific port number

if [ -z "$1" ]; then
  echo "Usage: $0 <port>"
  exit 1
fi

PORT=$1

PROCESS=$(sudo lsof -i :$PORT -t)

if [ -n "$PROCESS" ]; then
  echo "Process using port $PORT:"
  ps -fp $PROCESS
else
  echo "No process found using port $PORT."
fi

