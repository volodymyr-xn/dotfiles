#!/usr/bin/env bash

# Replaces file with symlink to "/dev/null"
# Usefull for different variants of log files on development

set -euo pipefail

filename=$1
full_path_to_file=$(readlink -f $filename)

# Delete provided file
rm $filename

# Create /dev/null synlink to the provided file
ln -s /dev/null $full_path_to_file
