# Books directory
MAIN_DIR=$1
PATTERN=${2:-".*"}

# Save find result to F_ARRAY
# DEPRECATED
# readarray -t FILES_PATH_LIST <<< "$(find "$MAIN_DIR" -type f -name "$PATTERN")"
readarray -t FILES_PATH_LIST <<< "$(fdfind "$PATTERN" "$MAIN_DIR" )"

echo $FILES_PATH_LIST


# Associative array for storing books
# key => book name
# value => absolute path to the file
# BOOKS['filename']='path'
declare -A FILES

# Add elements to BOOKS array
get_files() {

  # if [ ${#F_ARRAY[@]} != 0 ]; then
  if [[ ! -z ${FILES_PATH_LIST[@]} ]]; then
    for i in "${!FILES_PATH_LIST[@]}"
    do
      path=${FILES_PATH_LIST[$i]}
      file=$(basename "${FILES_PATH_LIST[$i]}")
      dirname=$(basename `dirname "${FILES_PATH_LIST[$i]}"`)

      key_name="$dirname/$file"
      FILES+=([$key_name]="$path")
    done
  else
      echo "$MAIN_DIR is empty!"
      exit
  fi


}

# List for rofi
gen_list(){
  for i in "${!FILES[@]}"
  do
    echo "$i"
  done
}

main() {
  get_files
  book=$( (gen_list) | rofi -dmenu -i -matching fuzzy -no-custom -location 0 -p "File" )

  if [ -n "$book" ]; then
    xdg-open "${FILES[$book]}"
  fi
}

main

exit 0
