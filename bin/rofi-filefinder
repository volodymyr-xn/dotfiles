#!/usr/bin/env sh

# Select file from directory with rofi and open with default app

set -euo pipefail

MAIN_DIR="$1"
PATTERN=${2:-".*"}

readarray -t FILES_PATH_LIST <<< "$(fdfind "$PATTERN" "$MAIN_DIR")"

declare -A FILES

get_files() {
  if [[ ! -z ${FILES_PATH_LIST[@]} ]]; then
    for i in "${!FILES_PATH_LIST[@]}"
    do
      path=${FILES_PATH_LIST[$i]}
      file=$(basename "${FILES_PATH_LIST[$i]}")
      dirname=$(basename `dirname "${FILES_PATH_LIST[$i]}"`)

      key_name="$dirname/$file"
      FILES+=([$key_name]="$path")
    done
  else
      echo "$MAIN_DIR is empty!"
      exit
  fi
}

gen_list(){
  for i in "${!FILES[@]}"
  do
    echo "$i"
  done
}

main() {
  get_files
  file=$( (gen_list) | rofi -dmenu -i -matching fuzzy -no-custom -location 0 -p "File" )

  if [ -n "$file" ]; then
    xdg-open "${FILES[$file]}"
  fi
}

main

exit 0
