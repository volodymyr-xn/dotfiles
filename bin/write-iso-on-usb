#!/usr/bin/env bash

iso=$1
disk=$2

write_on_disk () {
  echo "\nFake write"
  # sudo dd if="$iso" of="$disk" bs=1M status=progress
}

echo "You are going to write $iso on $disk"
read -n 1 -p "Are you sure (y/n)?" choise

case $choise in
  [Yy]* ) write_on_disk
  ;;
  [Nn]* ) exit
  ;;
  * ) exit
  ;;
esac
