#!/usr/bin/env python3
# Rewrite every tab label as "<number>:<name>", reproducing tmux's
# `window-status-format " #I:#W "` (tmux/tmux.conf:515). herdr keeps a per-
# workspace tab number in its data model but never renders it, so the number
# has to be baked into the label.
#
# Loop guard: renaming a tab emits tab.renamed, which re-invokes this hook.
# Tabs already carrying the right label are skipped, so a run that changes
# nothing emits nothing and the cascade stops at the first fixpoint.

import json
import os
import re
import subprocess
import sys

# Leading "12:" written by an earlier run, stripped before renumbering so the
# prefix never stacks.
NUMBER_PREFIX = re.compile(r"^\d+:")

# Stand-in for herdr's generated tab label, which is just the tab number as a
# string. Needed because ui.prompt_new_tab_name = false skips the name prompt.
GENERATED_LABEL = "new_tab"

HERDR = os.environ.get("HERDR_BIN_PATH") or "herdr"


# Run a herdr CLI command and return its parsed JSON reply.
def herdr(*arguments):
    completed = subprocess.run(
        [HERDR, *arguments],
        capture_output=True,
        text=True,
        check=True,
    )

    return json.loads(completed.stdout)


# The label a tab should carry at 1-based position $position. The number comes
# from the position, not from the tab's own `number`: herdr's counter never
# reuses a closed tab's number, so a fifth tab can be numbered 10 and the
# labels stop being sequential. tmux kept them packed with renumber-windows.
#
# Any all-digit name is herdr's generated placeholder rather than one anyone
# chose, so it reads as new_tab instead of a bare second number.
def numbered_label(tab, position):
    name = NUMBER_PREFIX.sub("", tab["label"])

    if name.isdigit():
        name = GENERATED_LABEL

    return "{}:{}".format(position, name)


def main():
    for workspace in herdr("workspace", "list")["result"]["workspaces"]:
        tabs = herdr("tab", "list", "--workspace", workspace["workspace_id"])["result"]["tabs"]

        for position, tab in enumerate(tabs, start=1):
            desired = numbered_label(tab, position)

            if tab["label"] != desired:
                herdr("tab", "rename", tab["tab_id"], desired)

    return 0


if __name__ == "__main__":
    sys.exit(main())
