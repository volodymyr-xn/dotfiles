system-setup

## vim-plug
# ignore everything
config/vim/plugged/
config/nvim/plugged/
config/tmux/plugins/
!config/tmux/plugins/tpm
vim/plugged/
nvim/plugged/
tmux/plugins/
!tmux/plugins/tpm
.vagrant
*.log
.DS_Store
.DS_Store?

## compiled native modules, rebuilt by setup/build_native_modules.sh
## (the platform dirs stay tracked, their binaries do not)
bin_native/*/*
!bin_native/*/.gitkeep

## docker: only config.json is a dotfile, everything else Docker writes
## (contexts, buildx state, cli-plugin links, token seed) is machine state
docker/*
!docker/config.json
