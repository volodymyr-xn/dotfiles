# Makes creating a new tmux session (with a specific name) easier
function tn() {
  tmux new -s $1
}

# Creates new tmux session from existing directory
function tm() {
  tmux new-session -As $(basename "$PWD" | tr . -)
}

# Makes attaching to an existing tmux session easier
function ta() {
  tmux attach
  # tmux attach -t $1
}

