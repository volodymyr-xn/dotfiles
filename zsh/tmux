# Kill stop tmux server and kill all sessions
alias tka="tmux kill-server"

# List tmux sessions
alias tl='tmux ls'

# Tmuxinator shortcut
alias tx='tmuxinator'

# Kill all tmux sessions
alias tka="tmux ls | cut -d : -f 1 | xargs -I {} tmux kill-session -t {}" # tmux kill all sessions

