# vim: syntax=bash
# nvim: syntax=bash

export ZSH=$HOME/.oh-my-zsh
#
DISABLE_UPDATE_PROMPT=true
DISABLE_AUTO_UPDATE=true
COMPLETION_WAITING_DOTS="true"

ZSH_THEME="avit_custom"
# ZSH_THEME="jispwoso"

# plugins=(git vi-mode)
# OMZ's vi-mode disabled: with tmux `focus-events on` + `escape-time 0`, the
# focus-in/out bytes (ESC[I / ESC[O) flip the line editor into NORMAL mode
# and the pane appears "frozen". If a vi keymap is wanted later, prefer
# jeffreytse/zsh-vi-mode — it claims focus + bracketed-paste sequences.
plugins=()
# plugins=(git vi-mode asdf gitfast)

# Custom completion functions (_tmuxinator, ...) must be on fpath before
# oh-my-zsh.sh runs compinit, otherwise they are never registered.
fpath=("$HOME/dotfiles/zsh/completions" $fpath)

source $ZSH/oh-my-zsh.sh

# MODE_INDICATOR="%F{yellow}NORMAL%f"
MODE_INDICATOR="%K{yellow}%F{black}%B VIM-MODE %b%f%k"
# INSERT_MODE_INDICATOR="%F{green}INSERT%f"
# INSERT_MODE_INDICATOR="%K{green}%f%F{black}INSERT%f%F"
INSERT_MODE_INDICATOR="%K{green}%F{black}%B REGULAR %b%f%k"
