# CTRL-o runs fzf switch tmux session
# bindkey -s "^o" "tmux split-window -h 'fzf-switch-tmux-session'\n"
bindkey -s "^o" 'fzf-switch-tmux-session\n'

# Git status
# ctrl-f
bindkey -s "^f" 'git status\n'

# Git diff staged files
# ctrl-e
bindkey -s "^e" 'git diff --staged\n'

# Experimental
bindkey -s "^n" 'cd ~/dev_notes\n'
