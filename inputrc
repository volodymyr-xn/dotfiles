set editing-mode vi
set blink-matching-paren on

"\e[1;5C": forward-word
"\e[1;5D": backward-word

"\e[1;3C": forward-word
"\e[1;3D": backward-word


"^n" backward-word
"^q" forward-word

# Enable 8-bit input (required for UTF-8)
# The setting `meta-flag` is an alias for this setting.
set input-meta on

