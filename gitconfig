[user]
	name = Volodymyr Shevchuk
	email = volodymyr.shevchuk.dev@gmail.com
[core]
	editor = vim
	excludesfile = ~/.gitignore_global
[color]
	ui = true
[push]
	default = current
[credential]
	helper = cache --timeout=360000
[alias]
  unstage = reset
  restore-branch-from = reset --hard
  uncommit = reset --soft HEAD^
  staged = diff --staged
  mdiff = diff master...
[fetch]
	prune = true
[commit]
	gpgsign = false

[alias]
# Add all files and display the status. (`g a`)
a = !git add -A && git status

# Commit the current index with a message. (`g c "Initial commit."`)
c = commit

# Amend the last commit message. (`g ca`)
ca = commit --amend

# Pull updates. (`g pl`)
pl = pull

# Push updates. (`g ps origin master`)
ps = push

# Pull and rebase the current branch. (`g plre`)
plre = pull --rebase

# Display the status. (`g st`)
st = status

# Rebase the current branch from an up-to-date origin/master. (`g up`)
up = !git fetch origin && git rebase origin/master
[init]
	defaultBranch = main

# hunk (https://hunk.dev) as the review UI for diff output. Kept on the
# per-command pager instead of core.pager so `git status`/`git log` without
# -p keep the plain pager.
[pager]
	diff = hunk pager
	show = hunk pager
	log = hunk pager
[diff]
	tool = hunk
[difftool]
	prompt = false
[difftool "hunk"]
	cmd = hunk difftool "$LOCAL" "$REMOTE" "$MERGED"
