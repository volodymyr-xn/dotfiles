	email = volodymyr.shevchuk93@gmail.com
[core]
	editor = vim
[color]
	ui = true
[push]
	default = current
[credential]
	helper = cache --timeout=360000
[alias]
  unstage = reset
  restore-branch-from = reset --hard
  uncommit = reset --soft HEAD^
  staged = diff --staged
  mdiff = diff master...
	s = status
[fetch]
	prune = true
[commit]
	gpgsign = false
